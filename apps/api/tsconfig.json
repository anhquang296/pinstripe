{
  "extends": "@pinstripe/config/tsconfig/node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@routes/*": [
        "src/routes/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@plugins/*": [
        "src/plugins/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tsup.config.ts"
  ]
}
