{
  "extends": "@pinstripe/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@app": ["./src/app.ts"],
      "@constants/*": ["./src/constants/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@routes/*": ["./src/routes/*"],
      "@utils/*": ["./src/utils/*"],
      "@plugins/*": ["./src/plugins/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "tsup.config.ts",
    "vitest.integration.config.ts"
  ]
}
