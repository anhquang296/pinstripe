{
  "name": "@vxrerp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --include '../../packages/core/dist/**/*.js' --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "openapi": "tsx scripts/generate-openapi.ts && prettier --write openapi.json",
    "bootstrap-admin": "tsx --env-file=../../.env scripts/bootstrap-admin.ts",
    "seed-demo": "tsx --env-file=../../.env scripts/seed-demo/index.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@vxrerp/core": "workspace:*",
    "@sinclair/typebox": "^0.34.13",
    "better-auth": "^1.7.5",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@vxrerp/eslint-config": "workspace:*",
    "@vxrerp/tsconfig": "workspace:*",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.8"
  }
}
