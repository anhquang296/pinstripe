{
  "name": "@pinstripe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --include '../../packages/core/dist/**/*.js' --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^5.1.0",
    "@pinstripe/core": "workspace:*",
    "@sinclair/typebox": "^0.34.13",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@pinstripe/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@pinstripe/eslint-config": "workspace:*",
    "eslint": "^9.39.4",
    "@types/lodash": "^4.17.13"
  }
}
